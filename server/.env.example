# Port du serveur (sera écrasé par SERVER_PORT si défini dans le fichier .env à la racine)
PORT=4059

# URL du frontend (sera écrasé par REACT_APP_FRONTEND_URL si défini dans le fichier .env à la racine)
# En dev: 3000, en prod: 4060
FRONTEND_URL=http://localhost:3000

# Origines CORS autorisées (liste séparée par des virgules).
# Laisser vide pour utiliser les valeurs par défaut (localhost + FRONTEND_URL).
# CORS_ORIGINS=http://localhost:3000,https://devjobs.creachtheo.fr

# Logs HTTP détaillés (utile en debug uniquement). true|false — défaut false.
# DEBUG_HTTP=false

# Configuration de l'API France Travail
# ⚠️ Ne jamais committer de vraies clés. Renseignez-les dans server/.env (gitignoré).
FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
FT_BASE_URL=https://api.francetravail.io/
FT_CLIENT_ID=votre_client_id
FT_CLIENT_SECRET=votre_client_secret
FT_SCOPE=o2dsoffre api_offresdemploiv2

# ── API « Statistiques offres & demandes d'emploi » (SODE) ─────────────────────
# Facultatif : active les tendances RÉELLES (évolution, tension) dans l'onglet Analyse.
# 1) Souscrire au produit sur francetravail.io avec la MÊME application (mêmes CLIENT_ID/SECRET).
# 2) FT_STATS_SCOPE : les DEUX scopes obligatoires du produit, séparés par un espace.
# 3) FT_STATS_BASE : déjà pré-réglé par défaut côté serveur ; ne le renseigner que pour surcharger.
FT_STATS_SCOPE=offresetdemandesemploi api_stats-offres-demandes-emploiv1
# FT_STATS_BASE=https://api.francetravail.io/partenaire/stats-offres-demandes-emploi/v1

# Mode (development ou production)
NODE_ENV=development

# Pour la production, modifiez les valeurs comme suit:
# FRONTEND_URL=http://localhost:4060
# NODE_ENV=production
